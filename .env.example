# Public request intake. This is convenient locally; keep it false in production until launch review.
REQUEST_ASSISTANT_PUBLIC_ENABLED=true
# Independent final-submission kill switch. Required as true in production only
# after the Supabase target, migrations, retention, and launch gate are approved.
REQUEST_SUBMISSION_ENABLED=false

# Optional OpenAI Responses API preview. AI runs only when the request sends
# useAi=true, this non-production preview flag is true, and the key is present.
# The adapter is fixed to gpt-5.6-luna (OpenAI Tier 1+; Free tier unsupported).
# Every request sets store=false, but that does not prove zero data retention:
# by default, redacted task text may remain in abuse-monitoring logs for up to 30 days.
OPENAI_API_KEY=
REQUEST_ASSISTANT_ALLOW_OPENAI_PREVIEW=false
# Display-only: set true only after OpenAI zero data retention is verified for
# this organization. It never enables production or bypasses the preview gate.
OPENAI_ZERO_DATA_RETENTION_VERIFIED=false
REQUEST_ASSISTANT_PROVIDER_TIMEOUT_MS=20000

# Local quota override only. Ignored in production; it does not bypass the
# OpenAI preview flag, per-request useAi opt-in, task-only gate, or DLP checks.
REQUEST_ASSISTANT_ALLOW_LOCAL_AI=false

# Bounded per-instance protection for every request.
REQUEST_ASSISTANT_RATE_LIMIT=12
REQUEST_ASSISTANT_RATE_WINDOW_MS=600000

# Required for public AI use: distributed per-client quota plus a daily
# provider-call circuit breaker. Create a dedicated Upstash Redis database.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REQUEST_ASSISTANT_AI_RATE_LIMIT=5
REQUEST_ASSISTANT_AI_RATE_WINDOW_MS=600000
REQUEST_ASSISTANT_DAILY_AI_LIMIT=200

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional comma-separated origins in addition to NEXT_PUBLIC_SITE_URL.
REQUEST_ASSISTANT_ALLOWED_ORIGINS=http://localhost:3000

# Existing request persistence and notification integrations.
# Local JSON request storage is opt-in for non-production development only.
CLAW_ALLOW_LOCAL_REQUEST_STORAGE=false
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
CLAW_REQUEST_TO_EMAIL=ops@yourdomain.com
CLAW_REQUEST_FROM_EMAIL="Claw Services <requests@yourdomain.com>"
