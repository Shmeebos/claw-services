# Public request intake. This is convenient locally; keep it false in production until launch review.
REQUEST_ASSISTANT_PUBLIC_ENABLED=true

# Optional AI path. The backend uses a deterministic guided fallback when this is empty.
OPENROUTER_API_KEY=
CLAW_REQUEST_ASSISTANT_MODEL=openai/gpt-4.1-mini
REQUEST_ASSISTANT_PROVIDER_TIMEOUT_MS=20000

# Best-effort per-instance protection. Use durable edge rate limiting before higher-volume launch.
REQUEST_ASSISTANT_RATE_LIMIT=12
REQUEST_ASSISTANT_RATE_WINDOW_MS=600000

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Existing request persistence and notification integrations.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
CLAW_REQUEST_TO_EMAIL=ops@yourdomain.com
CLAW_REQUEST_FROM_EMAIL="Claw Services <requests@yourdomain.com>"
